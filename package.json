{
  "name": "quantum-multi-agent-platform",
  "version": "1.7.0",
  "description": "宏大多agent开发调度平台 - 量子态协同架构（v1.7：全量质量跃迁）",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "example:basic": "tsx examples/basic-usage.js",
    "example:advanced": "tsx examples/advanced-workflow.js",
    "example:quantum": "tsx examples/quantum-breakthrough-benchmark.ts",
    "example:qpu": "tsx examples/qpu-real-hardware.ts",
    "performance": "tsx scripts/performance-test.mjs",
    "coverage": "c8 --include src/** --check-coverage --statements 90 --branches 80 --functions 90 --lines 90 --reporter=text --reporter=text-summary node --import tsx --test \"tests/**/*.test.ts\"",
    "knip": "knip"
  },
  "keywords": [
    "multi-agent",
    "quantum",
    "scheduling",
    "deepseek-harness",
    "ai",
    "orchestration"
  ],
  "author": "Quantum Agent Team",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.5.0",
    "@types/ws": "^8.5.5",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.69.0"
  }
}
