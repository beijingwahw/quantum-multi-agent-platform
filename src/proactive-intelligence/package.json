{
  "name": "dsh-proactive-intelligence",
  "version": "1.0.0",
  "description": "主动智能插件 - 自主感知、智能决策、主动干预系统",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./rules": {
      "types": "./rules.ts",
      "default": "./rules.ts"
    },
    "./examples": {
      "types": "./examples.ts",
      "default": "./examples.ts"
    }
  },
  "files": [
    "index.ts",
    "rules.ts",
    "examples.ts",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "proactive",
    "intelligence",
    "automation",
    "monitoring",
    "rules-engine",
    "event-driven"
  ],
  "author": "DSH Team",
  "license": "MIT",
  "dependencies": {
    "uuid": "^11.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc",
    "example": "tsx src/proactive-intelligence/examples.ts",
    "test": "echo \"Tests not implemented yet\" && exit 0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
