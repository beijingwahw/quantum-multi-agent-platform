{
  "name": "nonstoq-anneal",
  "version": "0.2.0",
  "description": "Non-stoquastic annealing route prototype: programmable XX-driver engines (real-time anneal + imaginary-time ground states), stoquasticity verifier, sign-structure barrier metric P = sum(psi)/sum(|psi|), and the element-level de-signing decider (certified YES/NO/UNRESOLVED)",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "repro": "tsx src/experiments/run-all.ts",
    "exp:sign": "tsx src/experiments/exp1-sign.ts",
    "exp:anneal": "tsx src/experiments/exp2-anneal.ts",
    "exp:sign-sse": "tsx src/experiments/exp3-sse-sign.ts",
    "exp:catalyst": "tsx src/experiments/exp4-catalyst.ts",
    "exp:scale": "tsx src/experiments/exp5-scale.ts",
    "exp:designability": "tsx src/experiments/exp6-designability.ts",
    "lint": "eslint ."
  },
  "keywords": [
    "quantum-annealing",
    "nonstoquastic",
    "sign-problem",
    "ising",
    "perron-frobenius"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.5.0",
    "eslint": "^10.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  }
}
